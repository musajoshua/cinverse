# DB_HOST is for running the app / migrations from your HOST machine, so it points
# at localhost (docker-compose publishes Postgres' port to the host).
# Inside Docker, docker-compose.yml overrides DB_HOST to the "cineverse-database"
# service name (the compose bridge network resolves containers by DNS name).
DB_HOST=localhost
DB_USERNAME=
DB_PASSWORD=
DB_PORT=
DB_NAME=cineverse

SERVER_PORT=3000